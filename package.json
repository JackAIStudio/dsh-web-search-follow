{
  "name": "dsh-web-search-follow",
  "version": "0.3.0",
  "private": true,
  "description": "DSH web_search backend that follows the current session model. Supports Grok, Gemini (Google Search), DeepSeek native search, and WorkBuddy CN/Global hosted search + fetch.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "parse.js",
    "deepseek.js",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.zh.md",
    "AGENTS.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JackAIStudio/dsh-web-search-follow.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "web-search",
    "grok",
    "gemini",
    "deepseek"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
